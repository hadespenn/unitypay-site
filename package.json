{
  "name": "unitypay-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/defer-blocking.mjs && next-sitemap",
    "pages:build": "npx @cloudflare/next-on-pages@1 && node scripts/defer-blocking.mjs && next-sitemap --config next-sitemap.cloudflare.config.js",
    "start": "next start",
    "lint": "next lint"
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 14",
    "ios >= 14",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "next": "15.4.10",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "next-sitemap": "^4.2.3",
    "typescript": "^5"
  }
}
